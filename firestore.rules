rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Move this to Firebase custom claims before production use.
    // It matches the existing protected admin account in admin_accounts.dart.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@psm.com';
    }

    function isOwnProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow read: if isOwnProfile(userId) || isAdmin();

      allow create: if isAdmin() || (
        isOwnProfile(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role in ['student', 'teacher', 'parent'] &&
        request.resource.data.status == (
          request.resource.data.role == 'teacher' ? 'pending_review' : 'active'
        )
      );

      allow update: if isAdmin() || (
        isOwnProfile(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );

      allow delete: if isAdmin();
    }

    match /students/{userId} {
      allow read: if isAdmin() || (isOwnProfile(userId) && resource.data.role == 'student');
      allow create, update: if isAdmin() || (
        isOwnProfile(userId) && request.resource.data.role == 'student'
      );
      allow delete: if isAdmin();
    }

    match /parents/{userId} {
      allow read: if isAdmin() || (isOwnProfile(userId) && resource.data.role == 'parent');
      allow create, update: if isAdmin() || (
        isOwnProfile(userId) && request.resource.data.role == 'parent'
      );
      allow delete: if isAdmin();
    }

    match /teachers/{userId} {
      allow read: if isAdmin() || (isOwnProfile(userId) && resource.data.role == 'teacher');
      allow create, update: if isAdmin() || (
        isOwnProfile(userId) && request.resource.data.role == 'teacher'
      );
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read, write: if isAdmin();
    }

    match /ai_questions/{questionId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    match /learning_resources/{resourceId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isTeacher() && resource.data.ownerId == request.auth.uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
